{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lamandos/toy-racers/schemas/behavioral-trace-v2.json",
  "title": "Toy Racers normalized behavioral golden trace",
  "description": "Versioned trace envelope containing sampled normalized behavioral snapshots.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scenarioId", "seed", "samples"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "scenarioId": { "type": "string", "minLength": 1 },
    "seed": {
      "type": "integer",
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sample" }
    }
  },
  "$defs": {
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "tick", "snapshot"],
      "properties": {
        "label": {
          "type": "string",
          "enum": ["countdown", "racing", "simulation"]
        },
        "tick": { "type": "integer", "minimum": 0 },
        "snapshot": {
          "$ref": "https://github.com/Lamandos/toy-racers/schemas/behavioral-snapshot-v2.json"
        }
      }
    }
  }
}

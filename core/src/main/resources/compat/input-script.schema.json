{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lamandos/toy-racers/schemas/behavioral-input-script-v1.json",
  "title": "Toy Racers behavioral input script",
  "description": "Versioned input segments referenced by a behavioral scenario.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "segments"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/segment" }
    }
  },
  "$defs": {
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromTick", "toTick"],
      "properties": {
        "fromTick": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "toTick": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "throttle": { "type": "number" },
        "brake": { "type": "number" },
        "steering": { "type": "number" }
      }
    }
  }
}

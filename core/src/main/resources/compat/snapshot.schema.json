{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lamandos/toy-racers/schemas/behavioral-snapshot-v2.json",
  "title": "Toy Racers normalized behavioral snapshot",
  "description": "Versioned, rendering-independent state used to compare equivalent fixed-timestep race implementations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "simulationTick",
    "raceState",
    "countdown",
    "elapsedSimulationTime",
    "currentLap",
    "currentProgress",
    "participants",
    "ranking",
    "finishedParticipants",
    "finishResults"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "simulationTick": { "type": "integer", "minimum": 0 },
    "raceState": {
      "type": "string",
      "enum": ["loading", "ready", "countdown", "racing", "paused", "finished"]
    },
    "countdown": { "$ref": "#/$defs/countdown" },
    "elapsedSimulationTime": { "type": "number", "minimum": 0 },
    "currentLap": {
      "type": "integer",
      "minimum": 1,
      "description": "One-based active lap for the player, capped at the required lap count after finishing."
    },
    "currentProgress": { "$ref": "#/$defs/progress" },
    "participants": {
      "type": "array",
      "minItems": 1,
      "description": "Sorted by stable participant ID in ascending lexicographic order.",
      "items": { "$ref": "#/$defs/participant" }
    },
    "ranking": {
      "type": "array",
      "minItems": 1,
      "description": "Participant IDs sorted by ascending racePosition, then participant ID.",
      "items": { "type": "string", "minLength": 1 }
    },
    "finishedParticipants": {
      "type": "array",
      "description": "Finished participant IDs sorted by finishPosition, then participant ID.",
      "items": { "type": "string", "minLength": 1 }
    },
    "finishResults": {
      "type": "array",
      "description": "Results sorted by finishPosition, then participantId.",
      "items": { "$ref": "#/$defs/finishResult" }
    }
  },
  "$defs": {
    "countdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "remainingSeconds"],
      "properties": {
        "state": { "type": "string", "enum": ["not-started", "active", "complete"] },
        "remainingSeconds": { "type": "number", "minimum": 0 }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint", "completedLaps"],
      "properties": {
        "checkpoint": { "type": "integer", "minimum": 0 },
        "completedLaps": { "type": "integer", "minimum": 0 }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "x",
        "y",
        "velocityX",
        "velocityY",
        "rotation",
        "angularVelocity",
        "longitudinalSpeed",
        "lateralSpeed",
        "driftAmount",
        "surface",
        "checkpoint",
        "lap",
        "racePosition",
        "finished"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "velocityX": { "type": "number" },
        "velocityY": { "type": "number" },
        "rotation": { "type": "number", "description": "Degrees." },
        "angularVelocity": { "type": "number", "description": "Degrees per second." },
        "longitudinalSpeed": { "type": "number" },
        "lateralSpeed": { "type": "number" },
        "driftAmount": { "type": "number" },
        "surface": {
          "type": "string",
          "enum": ["asphalt", "parquet", "tile", "grass", "boost", "oil"]
        },
        "checkpoint": { "type": "integer", "minimum": 0 },
        "lap": { "type": "integer", "minimum": 0, "description": "Completed laps." },
        "racePosition": { "type": "integer", "minimum": 1 },
        "finished": { "type": "boolean" }
      }
    },
    "finishResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["participantId", "finishPosition", "elapsedSimulationTime", "bestLapTime"],
      "properties": {
        "participantId": { "type": "string", "minLength": 1 },
        "finishPosition": { "type": "integer", "minimum": 1 },
        "elapsedSimulationTime": { "type": "number", "minimum": 0 },
        "bestLapTime": { "type": ["number", "null"], "minimum": 0 }
      }
    }
  }
}

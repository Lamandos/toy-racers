#!/bin/sh
set -eu

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root"

echo "Running full Kotlin and Flutter quality gates, coverage, mutation testing, and desktop UI smoke..."
if [ "$(uname -s)" = "Linux" ] && [ -z "${DISPLAY:-}" ]; then
  if ! command -v xvfb-run >/dev/null 2>&1; then
    echo "Headless Linux requires xvfb-run to execute desktop UI smoke tests."
    exit 1
  fi
  xvfb-run --auto-servernum ./gradlew qualityCheck --no-daemon
else
  ./gradlew qualityCheck --no-daemon
fi

if ! command -v flutter >/dev/null 2>&1; then
  echo "Flutter stable is required to run Dart quality checks."
  exit 1
fi

(
  cd dart
  flutter pub get --enforce-lockfile
  flutter analyze --fatal-infos
  flutter test --coverage
)

#!/bin/sh
set -eu

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root"

echo "Running fast local Kotlin and Dart pre-push gates..."
python3 tools/flutter_asset_pipeline.py check
python3 tools/test_flutter_asset_pipeline.py

if ! command -v flutter >/dev/null 2>&1; then
  echo "Flutter stable is required to run Dart quality checks."
  exit 1
fi

(
  cd dart
  flutter pub get --enforce-lockfile
  dart format --output=none --set-exit-if-changed .
  flutter analyze --fatal-infos
  flutter test
)

if [ "$(uname -s)" = "Linux" ] && [ -z "${DISPLAY:-}" ]; then
  if ! command -v xvfb-run >/dev/null 2>&1; then
    echo "Headless Linux requires xvfb-run to execute desktop UI smoke tests."
    exit 1
  fi
  xvfb-run --auto-servernum ./gradlew quickQualityCheck --no-daemon
else
  ./gradlew quickQualityCheck --no-daemon
fi

echo "Full compatibility and fuzz gates run once in GitHub CI."
